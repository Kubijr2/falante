FROM python:3.12-slim

WORKDIR /app

# Copy just the requirement files first so Docker can cache this layer —
# rebuilds only reinstall packages when requirements actually change, not
# on every code edit.
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

# The rest of the code is bind-mounted over this in docker-compose.yml for
# live editing — this COPY exists so `docker build` alone (e.g. in CI, or
# `docker run` without compose) still produces a complete, runnable image.
COPY . .

EXPOSE 8000

# Applies any pending Alembic migrations, then starts the dev server with
# hot reload. Running the migration on every container start is what makes
# "day-to-day" work: a fresh migration from a new milestone gets applied
# automatically the next time you bring the container up.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"]
