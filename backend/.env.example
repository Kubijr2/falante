# Copy this file to .env and adjust as needed.
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./falante.db

# To switch to Postgres later, just change this one line, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/falante

# Milestone 5+: AI features (Grammar Tutor, Writing Coach). The app runs
# fine with this left blank — AI features are simply disabled, per the
# original project requirement that AI is optional, never required.
AI_PROVIDER=openai
AI_API_KEY="your AI api key here"
AI_MODEL=gpt-4o-mini