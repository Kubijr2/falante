# Copy this file to .env and adjust as needed.
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./falante.db

# To switch to Postgres later, just change this one line, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/falante
# (Verified end-to-end against real Postgres 16 as of Milestone 9.)

# AI features (Grammar Tutor, Writing Coach). The app runs fine with this
# left blank — AI features are simply disabled, per the original project
# requirement that AI is optional, never required.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# How many AI requests per visitor (identified by IP) per day, across the
# Tutor and Writing Coach combined. Protects against runaway API cost on a
# public deployment. Easy to change any time — no code change needed.
AI_RATE_LIMIT_PER_DAY=10

# Accepts a plain comma-separated list (easiest to set on most hosting
# platforms) or a JSON list. Defaults to the local Vite dev server.
CORS_ORIGINS=http://localhost:5173

# Auth (Milestone 10) — Google Sign-In. GOOGLE_CLIENT_ID must match the
# OAuth Client ID from Google Cloud Console (see README for setup steps);
# the frontend's VITE_GOOGLE_CLIENT_ID must be the *same* value.
GOOGLE_CLIENT_ID=

# Google also generates a Client Secret alongside the Client ID. This app
# does NOT use it — the sign-in flow verifies a token client-side and never
# needs a server-to-server secret exchange. Safe to leave unset; keeping it
# here (unused) is just so it's not lost if you saved it and want a record
# of where it'd go if a future feature ever needed it.
GOOGLE_CLIENT_SECRET=

# Signs the app's own session tokens (issued after a successful Google
# login). The default below is intentionally obvious/insecure — change it
# to a real random value outside local dev:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
